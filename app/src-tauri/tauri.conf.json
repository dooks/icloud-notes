{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iCloud Notes",
  "version": "0.1.0",
  "identifier": "com.ziggy.icloud-notes",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' notes-asset: http://notes-asset.localhost; frame-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
